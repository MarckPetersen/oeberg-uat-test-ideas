# Copy to .env for local development (never commit .env). In GitHub Codespaces use Codespaces secrets instead.
ANTHROPIC_API_KEY=
# Required – a current Claude model ID. No default is hardcoded.
ANTHROPIC_MODEL=
# Optional
UAT_MAX_CALLS_PER_DAY=30
UAT_MAX_INPUT_CHARS=4000
UAT_MAX_OUTPUT_TOKENS=2000
UAT_DATA_DIR=.uat
